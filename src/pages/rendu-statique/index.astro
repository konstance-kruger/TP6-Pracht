---
import Layout from "../../layouts/Layout.astro";
import penguins from "../../assets/penguins.json";

const species = [...new Set(penguins.map((p) => p.species))];
---

<Layout>
  <h1>Rendu statique</h1>
  <p>Choisis une espèce :</p>

  <div class="species-list">
    {
      species.map((currentSpecies) => (
        <a
          class="species-button"
          href={`/rendu-statique/${currentSpecies}`}
        >
          {currentSpecies}
        </a>
      ))
    }
  </div>
</Layout>
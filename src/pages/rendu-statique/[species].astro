---
import Layout from "../../layouts/Layout.astro";
import PlotFigure from "../../components/PlotFigure.astro";
import penguins from "../../assets/penguins.json";
import * as Plot from "@observablehq/plot";

export function getStaticPaths() {
  const species = [...new Set(penguins.map((p) => p.species))];

  return species.map((currentSpecies) => ({
    params: {
      species: currentSpecies,
    },
  }));
}

const { species } = Astro.params;

const filteredPenguins = penguins.filter(
  (p) => p.species === species
);

const plotOptions = {
  marks: [
    Plot.dot(filteredPenguins, {
      x: "culmen_length_mm",
      y: "culmen_depth_mm",
      stroke: "species",
    }),
  ],
  x: {
    label: "Longueur du bec (mm)",
  },
  y: {
    label: "Profondeur du bec (mm)",
  },
  title: `Espèce : ${species}`,
};
---

<Layout>
  <h1>{species}</h1>

  <p>{filteredPenguins.length} pingouin(s) trouvé(s)</p>

  <PlotFigure options={plotOptions} />

  <a class="back-button" href="/rendu-statique">
    ← Retour
  </a>
</Layout>